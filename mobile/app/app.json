{
  "expo": {
    "name": "Farm & Lab",
    "slug": "farmlab",
    "version": "0.1.0",
    "scheme": "farmlab",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "org.farmlab.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "The app talks to your farm hub over the local Wi-Fi network."
      }
    },
    "android": {
      "package": "org.farmlab.app"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
